# Copy to .env for local runs: cp .env.example .env
# On Vercel, set these under Project → Settings → Environment Variables.
# Check what's still missing with: bun run check-env

# --- Required: your Supabase project (Supabase → Project Settings → API) ---
# The publishable key is safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Optional: "Suggest values" on the Fix it screen, through Vercel AI Gateway ---
# On Vercel nothing is needed: the deployment's OIDC token signs in to the gateway.
# Locally, either run `vercel env pull .env.local` (adds VERCEL_OIDC_TOKEN, valid 12 hours)
# or create a key under Vercel → AI Gateway → API keys.
AI_GATEWAY_API_KEY=
# Any AI Gateway model id. Defaults to anthropic/claude-sonnet-5.5.
AI_MODEL=

# --- Optional: Google Sheets sync on Approved data ---
# A Google Cloud OAuth client (type "Web application") whose authorized redirect URIs
# include https://<your-domain>/oauth/google-sheets/return (and the localhost one).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes in base64; encrypts stored Google refresh tokens. Use the same value
# everywhere that shares the database. Make one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
